# Banking Application Environment Configuration
# NOTICE: DEMO - simulated money, not a real bank.

NODE_ENV=development
PORT=4003
FRONTEND_URL=http://localhost:3003

# PostgreSQL fintrack_banking_db on Port 5433
DATABASE_URL="postgresql://fintrack_admin:fintrack_secure_password@localhost:5433/fintrack_banking_db?schema=public"

# Redis on Port 6383
REDIS_HOST=localhost
REDIS_PORT=6383

# JWT Authentication
JWT_SECRET=fintrack_banking_simulated_secret_key_32bytes_minimum
JWT_EXPIRES_IN=1d

# Transfer Defaults
MAX_DAILY_TRANSFER_LIMIT=25000.00
MAX_SINGLE_TRANSFER_LIMIT=5000.00
