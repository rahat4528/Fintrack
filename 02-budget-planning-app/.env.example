# Budget Planning App Environment Configuration

NODE_ENV=development
PORT=4002
FRONTEND_URL=http://localhost:3002

# PostgreSQL fintrack_budget_db on Port 5432
DATABASE_URL="postgresql://fintrack_admin:fintrack_secure_password@localhost:5432/fintrack_budget_db?schema=public"

# Redis Cache on Port 6382
REDIS_HOST=localhost
REDIS_PORT=6382

# JWT Authentication
JWT_SECRET=fintrack_budget_planning_development_secret_key_32bytes_min
JWT_EXPIRES_IN=7d

# Default Planning Currency
DEFAULT_CURRENCY=USD
