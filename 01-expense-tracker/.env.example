# Expense Tracker Environment Configuration

# Application
NODE_ENV=development
PORT=4001
FRONTEND_URL=http://localhost:3001

# Database Configuration (PostgreSQL fintrack_expense_db on port 5431)
DATABASE_URL="postgresql://fintrack_admin:fintrack_secure_password@localhost:5431/fintrack_expense_db?schema=public"

# Redis Cache and BullMQ Queue
REDIS_HOST=localhost
REDIS_PORT=6381

# JWT Secrets
JWT_SECRET=fintrack_expense_development_jwt_secret_key_32bytes_minimum
JWT_EXPIRES_IN=7d

# Default Currency
DEFAULT_CURRENCY=USD
