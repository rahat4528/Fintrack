datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum AccountType {
  CASH
  CHECKING
  SAVINGS
  CREDIT_CARD
  INVESTMENT
  OTHER
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

enum RecurrenceFrequency {
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
  YEARLY
}

enum RuleOperator {
  EQUALS
  CONTAINS
  STARTS_WITH
  GREATER_THAN
  LESS_THAN
}

enum RuleActionType {
  SET_CATEGORY
  ADD_TAG
  SET_DESCRIPTION
}

enum AlertThresholdType {
  AMOUNT
  PERCENTAGE
}

model User {
  id                   String                 @id @default(uuid())
  email                String                 @unique
  passwordHash         String
  fullName             String
  defaultCurrency      String                 @default("USD")
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  accounts             FinancialAccount[]
  categories           TransactionCategory[]
  tags                 TransactionTag[]
  transactions         Transaction[]
  recurringTransactions RecurringTransaction[]
  rules                TransactionRule[]
  savingsGoals         SavingsGoal[]
  budgetAlerts         BudgetAlert[]
  importBatches        ImportBatch[]
  auditLogs            AuditLog[]

  @@map("users")
}

model FinancialAccount {
  id              String       @id @default(uuid())
  userId          String
  name            String
  accountType     AccountType  @default(CHECKING)
  currency        String       @default("USD")
  currentBalance  Decimal      @default(0.00) @db.Decimal(15, 2)
  initialBalance  Decimal      @default(0.00) @db.Decimal(15, 2)
  isArchived      Boolean      @default(false)
  colorHex        String       @default("#3b82f6")
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions    Transaction[]
  outgoingTransfers TransactionTransfer[] @relation("SourceAccount")
  incomingTransfers TransactionTransfer[] @relation("DestinationAccount")

  @@index([userId])
  @@map("financial_accounts")
}

model TransactionCategory {
  id              String       @id @default(uuid())
  userId          String
  name            String
  colorHex        String       @default("#10b981")
  iconName        String       @default("tag")
  parentCategoryId String?
  isSystem        Boolean      @default(false)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentCategory  TransactionCategory?  @relation("CategoryHierarchy", fields: [parentCategoryId], references: [id])
  subCategories   TransactionCategory[] @relation("CategoryHierarchy")
  transactions    Transaction[]
  budgetAlerts    BudgetAlert[]

  @@unique([userId, name])
  @@index([userId])
  @@map("transaction_categories")
}

model TransactionTag {
  id          String   @id @default(uuid())
  userId      String
  name        String
  colorHex    String   @default("#6b7280")
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions TransactionTagAssignment[]

  @@unique([userId, name])
  @@index([userId])
  @@map("transaction_tags")
}

model Transaction {
  id                   String           @id @default(uuid())
  userId               String
  accountId            String
  categoryId           String?
  importBatchId        String?
  recurringId          String?
  type                 TransactionType
  amount               Decimal          @db.Decimal(15, 2)
  currency             String           @default("USD")
  description          String
  notes                String?
  transactionDate      DateTime
  isCleared            Boolean          @default(true)
  deletedAt            DateTime?
  externalId           String?
  contentHash          String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  user                 User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  account              FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  category             TransactionCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  importBatch          ImportBatch?     @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  recurringSource      RecurringTransaction? @relation(fields: [recurringId], references: [id], onDelete: SetNull)
  tags                 TransactionTagAssignment[]
  transferAsSource     TransactionTransfer? @relation("TransferSourceTransaction")
  transferAsDestination TransactionTransfer? @relation("TransferDestinationTransaction")

  @@index([userId, transactionDate])
  @@index([accountId])
  @@index([categoryId])
  @@index([contentHash])
  @@map("transactions")
}

model TransactionTagAssignment {
  transactionId String
  tagId         String

  transaction   Transaction    @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  tag           TransactionTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([transactionId, tagId])
  @@map("transaction_tag_assignments")
}

model TransactionTransfer {
  id                       String           @id @default(uuid())
  sourceAccountId          String
  destinationAccountId     String
  sourceTransactionId      String           @unique
  destinationTransactionId String           @unique
  exchangeRate             Decimal          @default(1.000000) @db.Decimal(18, 6)
  createdAt                DateTime         @default(now())

  sourceAccount            FinancialAccount @relation("SourceAccount", fields: [sourceAccountId], references: [id], onDelete: Restrict)
  destinationAccount       FinancialAccount @relation("DestinationAccount", fields: [destinationAccountId], references: [id], onDelete: Restrict)
  sourceTransaction        Transaction      @relation("TransferSourceTransaction", fields: [sourceTransactionId], references: [id], onDelete: Cascade)
  destinationTransaction   Transaction      @relation("TransferDestinationTransaction", fields: [destinationTransactionId], references: [id], onDelete: Cascade)

  @@map("transaction_transfers")
}

model RecurringTransaction {
  id              String              @id @default(uuid())
  userId          String
  accountId       String
  categoryId      String?
  type            TransactionType
  amount          Decimal             @db.Decimal(15, 2)
  currency        String              @default("USD")
  description     String
  frequency       RecurrenceFrequency
  startDate       DateTime
  endDate         DateTime?
  nextOccurrence  DateTime
  isActive        Boolean             @default(true)
  autoPost        Boolean             @default(true)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  occurrences     RecurringOccurrence[]
  transactions    Transaction[]

  @@index([userId])
  @@map("recurring_transactions")
}

model RecurringOccurrence {
  id            String               @id @default(uuid())
  recurringId   String
  occurrenceDate DateTime            @db.Date
  status        String               @default("POSTED") // POSTED, SKIPPED
  createdAt     DateTime             @default(now())

  recurring     RecurringTransaction @relation(fields: [recurringId], references: [id], onDelete: Cascade)

  @@unique([recurringId, occurrenceDate])
  @@map("recurring_occurrences")
}

model TransactionRule {
  id          String         @id @default(uuid())
  userId      String
  name        String
  priority    Int            @default(0)
  field       String         // description, amount, accountId
  operator    RuleOperator
  matchValue  String
  actionType  RuleActionType
  actionValue String
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, priority])
  @@map("transaction_rules")
}

model SavingsGoal {
  id             String    @id @default(uuid())
  userId         String
  name           String
  targetAmount   Decimal   @db.Decimal(15, 2)
  currentAmount  Decimal   @default(0.00) @db.Decimal(15, 2)
  currency       String    @default("USD")
  targetDate     DateTime?
  isCompleted    Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("savings_goals")
}

model BudgetAlert {
  id             String             @id @default(uuid())
  userId         String
  categoryId     String
  thresholdType  AlertThresholdType @default(AMOUNT)
  thresholdValue Decimal            @db.Decimal(15, 2)
  currency       String             @default("USD")
  periodMonth    Int                // 1 - 12
  periodYear     Int                // 2026 etc
  hasFired       Boolean            @default(false)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  category       TransactionCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId, periodYear, periodMonth])
  @@map("budget_alerts")
}

model ImportBatch {
  id            String        @id @default(uuid())
  userId        String
  filename      String
  totalRows     Int           @default(0)
  importedRows  Int           @default(0)
  duplicateRows Int           @default(0)
  failedRows    Int           @default(0)
  isReverted    Boolean       @default(false)
  createdAt     DateTime      @default(now())

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions  Transaction[]

  @@index([userId])
  @@map("import_batches")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String
  action     String
  entityType String
  entityId   String
  metadata   Json?
  timestamp  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, timestamp])
  @@map("audit_logs")
}
